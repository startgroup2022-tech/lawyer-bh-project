# Legal SOS · Admin — Environment Variables
#
# Local dev:  copy to `.env.local` and fill in
# Production: set in Vercel → Settings → Environment Variables
#
# ─────────────────────────────────────────────────────────────────────
# Required at boot
# ─────────────────────────────────────────────────────────────────────

# Postgres connection string. Neon (prod) or Docker Postgres (dev).
#   Local: postgresql://postgres:postgres@localhost:5432/legal_sos_admin
#   Prod:  postgres://USER:PASSWORD@HOST.neon.tech/legalsos?sslmode=require
DATABASE_URL=

# Public URL where the admin app is served. Used in emails / OAuth redirects.
NEXT_PUBLIC_APP_URL=http://localhost:3011

# Session-cookie HMAC secret. ≥32 random chars. Used to sign opaque
# admin session cookies. Rotate by re-issuing — old sessions invalidate.
#   Generate with: openssl rand -base64 48
AUTH_SECRET=

# ─────────────────────────────────────────────────────────────────────
# Seed script (one-off use)
# ─────────────────────────────────────────────────────────────────────

# Used only by `npm run seed:admin`. Never commit a real value.
#   SEED_ADMIN_EMAIL=info@lawyers.bh
#   SEED_ADMIN_NAME="Legal SOS Admin"
#   SEED_ADMIN_PASSWORD=...

# ─────────────────────────────────────────────────────────────────────
# Twilio (SMS OTP via Twilio Verify) — needed when mobile-side OTP wiring lands
# ─────────────────────────────────────────────────────────────────────

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# ─────────────────────────────────────────────────────────────────────
# SendGrid (transactional email — receipts, payout statements)
# ─────────────────────────────────────────────────────────────────────

SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@legalsos.lawyer
SENDGRID_FROM_NAME=Legal SOS

# ─────────────────────────────────────────────────────────────────────
# Pusher (realtime case channels + Beams push fanout)
# ─────────────────────────────────────────────────────────────────────

PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=ap2

# Server-side push (Beams) — used by the dispatch fan-out to lawyer phones
PUSHER_BEAMS_INSTANCE_ID=
PUSHER_BEAMS_SECRET=

# Public client-side key for Channels subscriptions in the admin UI
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=ap2

# ─────────────────────────────────────────────────────────────────────
# Tap Payments (BHD charges + KNET + Benefit Pay)
# ─────────────────────────────────────────────────────────────────────

NEXT_PUBLIC_TAP_SECRET_KEY=
NEXT_PUBLIC_TAP_PUBLIC_KEY=
TAP_WEBHOOK_SECRET=

# ─────────────────────────────────────────────────────────────────────
# Google Maps Platform (server-side: Directions + Distance Matrix + Geocoding)
# ─────────────────────────────────────────────────────────────────────

GOOGLE_MAPS_SERVER_KEY=

# ─────────────────────────────────────────────────────────────────────
# Cloudflare R2 (evidence uploads, signed consent PDFs)
# ─────────────────────────────────────────────────────────────────────

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=legal-sos-evidence
# https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=

# ─────────────────────────────────────────────────────────────────────
# Agora (in-app voice/video consultation rooms)
# ─────────────────────────────────────────────────────────────────────

AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# ─────────────────────────────────────────────────────────────────────
# Sentry (error reporting)
# ─────────────────────────────────────────────────────────────────────
# Create a SEPARATE Node.js project at sentry.io (don't reuse the RN
# mobile one). Org: gulf-international-collection.

# Server-side DSN — also used by the edge runtime if we add edge routes
SENTRY_DSN=
# Client-side DSN — usually the same DSN as SENTRY_DSN for Next.js apps
NEXT_PUBLIC_SENTRY_DSN=
# Auth token for source map uploads at build time (sentry.io → Settings
# → Auth Tokens → 'project:releases' scope)
SENTRY_AUTH_TOKEN=
# Org slug + project slug used by withSentryConfig for source-map upload
SENTRY_ORG=gulf-international-collection
SENTRY_PROJECT=legal-sos-admin

# ─────────────────────────────────────────────────────────────────────
# PostHog (product analytics — admin web)
# ─────────────────────────────────────────────────────────────────────

NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.posthog.com
