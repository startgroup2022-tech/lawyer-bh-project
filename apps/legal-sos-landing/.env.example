# Legal SOS · Landing — Environment Variables
#
# Landing is a static marketing site. It does NOT talk to the database
# directly. The only env vars it needs are for analytics + (optional)
# the "Get the app" links pointing at the App Store / Play Store.

# Where the admin/backend is served — used for the "Operator login" link
# in the footer.
NEXT_PUBLIC_APP_URL=https://admin.legalsos.lawyer

# App Store / Play Store URLs. Empty values render the badges as
# "Coming soon" placeholders.
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_PLAY_STORE_URL=

# PostHog (product analytics on the marketing site)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.posthog.com

# Sentry — landing has minimal JS, mostly static. A DSN here is optional.
SENTRY_DSN=
