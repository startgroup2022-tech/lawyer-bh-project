# Legal SOS · Mobile (Expo) — Environment Variables
#
# Anything starting with EXPO_PUBLIC_ is bundled into the JS shipped to
# the device. NEVER put secret keys here — only public/client-side IDs.
#
# Local dev:  copy to `.env` (Expo auto-loads) and fill in
# EAS builds: set via `eas secret:create` or `eas.json` env per-profile
# ─────────────────────────────────────────────────────────────────────

# URL of the admin backend's tRPC root. Same backend serves admin web
# AND the mobile app (single source of truth).
#   Local dev:   http://192.168.x.x:3011   (your LAN IP, NOT localhost)
#   Production:  https://admin.legalsos.lawyer
EXPO_PUBLIC_API_URL=http://localhost:3011

# Sentry DSN — React Native project. Get this from sentry.io →
# legal-sos-mobile → Settings → Client Keys (DSN). Public per Sentry's
# design (identifies project, not authenticates).
EXPO_PUBLIC_SENTRY_DSN=

# PostHog public key (mobile)
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://eu.posthog.com

# Pusher client key (Channels subscriptions for case status updates)
EXPO_PUBLIC_PUSHER_KEY=
EXPO_PUBLIC_PUSHER_CLUSTER=ap2

# Pusher Beams instance ID (for push-notification subscriptions)
EXPO_PUBLIC_PUSHER_BEAMS_INSTANCE_ID=

# Google Maps client SDK keys — per-platform, restricted to bundle IDs
# These are public per Google's design but MUST be restricted in the
# Google Cloud console to the iOS bundle ID + Android package name.
EXPO_PUBLIC_GOOGLE_MAPS_IOS_KEY=
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_KEY=

# Agora App ID (token is fetched server-side per-call via tRPC)
EXPO_PUBLIC_AGORA_APP_ID=
