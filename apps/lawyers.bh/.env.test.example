# Lawyers.bh - TEST environment template (https://test.lawyers.bh)
#
# Copy to .env.test on the TEST server only, then replace every <...> marker.
# This file holds NAMES and placeholders only - never commit real secrets.
# Never use this file for production.
#
# How to use:
#   node scripts/run-migrations.mjs && next build
# Variables marked REQUIRED FOR BUILD must be present at build time, because the
# app validates them while Next.js collects page data (module-scope config).

# ---------------------------------------------------------------------------
# REQUIRED FOR BUILD
# ---------------------------------------------------------------------------
# Postgres URL used by BOTH the migrator and `next build` page-data collection.
# Migrator precedence: POSTGRES_URL_NON_POOLING > DATABASE_URL_UNPOOLED >
# DATABASE_URL > POSTGRES_URL. Set DATABASE_URL (unpooled is fine for TEST).
DATABASE_URL=postgres://<db_user>:<db_password>@<db_host>:5432/<db_name>

# Tap Payments - `getTapConfig()` runs at module scope, so the build needs all
# five. Use TEST/sandbox keys for the TEST server. Do not disable Tap.
TAP_SECRET_KEY=<tap_test_secret_key_sk_test_...>
NEXT_PUBLIC_TAP_PUBLIC_KEY=<tap_test_public_key_pk_test_...>
TAP_MERCHANT_ID=<tap_merchant_id>
TAP_MARKETPLACE_MID=<tap_marketplace_mid>

# Public origin used to build Tap redirect/webhook URLs. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://test.lawyers.bh

# ---------------------------------------------------------------------------
# REQUIRED FOR RUNTIME (not needed to build; app features fail without them)
# ---------------------------------------------------------------------------
# Session / CSRF signing secrets. ADMIN_AUTH_SECRET is required for the admin
# panel; LAWYER_AUTH_SECRET for lawyer+provider sessions. All must be long,
# random strings - never reuse the production values on TEST.
ADMIN_AUTH_SECRET=<random_32+_char_secret>
LAWYER_AUTH_SECRET=<random_32+_char_secret>

# Saraya (real-estate) access tokens. Required for Saraya login.
SARAYA_ACCESS_TOKEN_SECRET=<random_32+_char_secret>

# ---------------------------------------------------------------------------
# OPTIONAL INTEGRATIONS (leave blank to disable the corresponding feature)
# ---------------------------------------------------------------------------
# Outbound email (Postmark). POSTMARK_API_TOKEN is accepted as an alias of
# POSTMARK_SERVER_TOKEN. Required for verification/reset/invite emails.
POSTMARK_SERVER_TOKEN=<postmark_server_token>
POSTMARK_FROM_EMAIL=<verified_sender_email>
POSTMARK_TO_EMAIL=<default_recipient_email>
POSTMARK_MESSAGE_STREAM=outbound

# Legacy alias used by the migration/seed tooling.
POSTMARK_API_TOKEN=<postmark_server_token_or_blank>

# Object storage (Vercel Blob) for uploads, icons, and private documents.
BLOB_READ_WRITE_TOKEN=<vercel_blob_read_write_token>
PRIVATE_BLOB_READ_WRITE_TOKEN=<vercel_blob_private_token>

# Saraya invitation / password-recovery delivery.
SARAYA_APP_URL=<saraya_public_base_url>
SARAYA_INVITATION_FROM=<verified_sender_email>
SARAYA_SMS_WEBHOOK_URL=<sms_gateway_url>
SARAYA_SMS_WEBHOOK_SECRET=<sms_gateway_secret>
# Optional override; defaults to SARAYA_ACCESS_TOKEN_SECRET.
SARAYA_PUBLIC_OTP_SECRET=<random_32+_char_secret_or_blank>
# Set to 1 only when the app runs behind a trusted reverse proxy (nginx).
SARAYA_TRUST_PROXY_HEADERS=0

# Provider password reset (falls back to LAWYER_AUTH_SECRET / NEXTAUTH_SECRET).
RESET_PASSWORD_SECRET=<random_32+_char_secret_or_blank>
CLIENT_AUTH_SECRET=<random_32+_char_secret_or_blank>

# Mobile push / realtime / dispatch (feature-gated).
COMMUNICATION_SOCKET_SECRET=<random_32+_char_secret_or_blank>
MOBILE_DISPATCH_SECRET=<random_32+_char_secret_or_blank>
NEXT_PUBLIC_VAPID_PUBLIC_KEY=<web_push_vapid_public_key>
VAPID_PRIVATE_KEY=<web_push_vapid_private_key>
VAPID_SUBJECT=<mailto:admin@example.com>
FIREBASE_PROJECT_ID=<firebase_project_id>
FIREBASE_CLIENT_EMAIL=<firebase_client_email>
FIREBASE_PRIVATE_KEY=<firebase_private_key_with_\n_escapes>
APNS_KEY_ID=<apple_push_key_id>
APNS_PRIVATE_KEY=<apple_push_private_key>
APNS_ENVIRONMENT=<sandbox_or_production>

# WhatsApp assistant.
META_WHATSAPP_ACCESS_TOKEN=<meta_whatsapp_access_token>
META_WHATSAPP_PHONE_NUMBER_ID=<meta_phone_number_id>
META_WHATSAPP_GRAPH_VERSION=<meta_graph_version>
META_WHATSAPP_APP_SECRET=<meta_app_secret>
META_WHATSAPP_VERIFY_TOKEN=<meta_webhook_verify_token>
OPENAI_API_KEY=<openai_api_key>
OPENAI_WHATSAPP_MODEL=<openai_model_name>

# Google / maps.
GOOGLE_ROUTES_API_KEY=<google_routes_api_key>
CLOUDFLARE_TURN_KEY_ID=<cloudflare_turn_key_id>
CLOUDFLARE_TURN_KEY_API_TOKEN=<cloudflare_turn_api_token>

# LegalSOS integration and public URLs.
LEGAL_SOS_WEBSITE_URL=<legalsos_https_origin>
NEXT_PUBLIC_APP_URL=<public_app_origin>
APP_URL=<public_app_origin>
SITE_URL=<public_app_origin>

# Tap mobile-app keys (used by /api/mobile/tap/* routes).
TAP_IOS_PUBLIC_KEY=<tap_ios_public_key>
TAP_ANDROID_PUBLIC_KEY=<tap_android_public_key>
TAP_MOBILE_TEST_SECRET_KEY=<tap_mobile_test_secret_key>
TAP_MOBILE_TEST_PUBLIC_KEY=<tap_mobile_test_public_key>
TAP_MOBILE_TEST_MERCHANT_ID=<tap_mobile_test_merchant_id>
NEXT_PUBLIC_TAP_MERCHANT_ID=<tap_merchant_id>

# Saraya mobile app-link association (leave blank to publish empty associations).
SARAYA_ANDROID_SHA256_CERT_FINGERPRINTS=<sha256_fingerprint_csv_or_blank>
SARAYA_APPLE_TEAM_ID=<apple_team_id_or_blank>
# Apple VoIP push (APPLE_TEAM_ID is read here; IOS_BUNDLE_ID has a default).
APPLE_TEAM_ID=<apple_team_id_or_blank>
IOS_BUNDLE_ID=<ios_bundle_id>

# Optional local storage root for Saraya documents in non-production.
SARAYA_LOCAL_DOCUMENT_ROOT=<local_path_or_blank>

# YourGPT chat widget (optional).
NEXT_PUBLIC_ENABLE_YOURGPT=<0_or_1>
NEXT_PUBLIC_YOURGPT_WIDGET_ID=<yourgpt_widget_id>
NEXT_PUBLIC_YOURGPT_WIDGET_ID_AR=<yourgpt_widget_id_ar>
NEXT_PUBLIC_YOURGPT_WIDGET_ID_EN=<yourgpt_widget_id_en>
YOURGPT_BOOKING_SECRET=<yourgpt_booking_secret>

# SOS dispatch operators. Either DISPATCH_USERS ("user:pass,user2:pass2") or
# DISPATCH_USERNAME + DISPATCH_PASSWORD.
DISPATCH_USERS=<user:pass,user2:pass2>
DISPATCH_USERNAME=<dispatch_username>
DISPATCH_PASSWORD=<dispatch_password>
SOS_DISPATCH_EMAIL=<dispatch_notification_email>
SOS_DISPATCH_PHONE=<dispatch_phone>
SOS_ADVOCATE_CUT_PERCENT=<numeric_percent>
PROFESSIONAL_OFFICE_EMAIL=<professional_office_email>
ADMIN_REQUEST_EMAIL=<admin_requests_email>

# Scheduled-job auth for /api/cron/* endpoints.
CRON_SECRET=<random_32+_char_secret>

# Account-deletion workflow gate.
LEGALSOS_DELETION_WORKFLOW_READY=<0_or_1>

# ---------------------------------------------------------------------------
# ADMIN SEEDING (used by scripts/seed-admin.mjs; not read by the web app)
# ---------------------------------------------------------------------------
ADMIN_NAME=<admin_display_name>
ADMIN_EMAIL=<admin_login_email>
ADMIN_PASSWORD=<strong_admin_password>
ADMIN_ROLE=super_admin
ADMIN_RESET_PASSWORD=false

# ---------------------------------------------------------------------------
# TAP APPLE PAY (optional)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_TAP_APPLE_PAY_DOMAIN=<apple_pay_domain>
NEXT_PUBLIC_TAP_APPLE_PAY_ENV=<sandbox_or_production>
