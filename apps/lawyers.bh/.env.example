POSTMARK_SERVER_TOKEN=your-postmark-server-token
POSTMARK_FROM_EMAIL=noreply@lawyers.bh
POSTMARK_TO_EMAIL=info@lawyers.bh
POSTMARK_MESSAGE_STREAM=outbound

# Tap Payments — keep all secret and marketplace identifiers server-side.
TAP_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_TAP_PUBLIC_KEY=pk_test_xxx
TAP_IOS_PUBLIC_KEY=pk_test_xxx
TAP_ANDROID_PUBLIC_KEY=pk_test_xxx
TAP_MOBILE_TEST_SECRET_KEY=sk_test_xxx
TAP_MOBILE_TEST_PUBLIC_KEY=pk_test_xxx
TAP_MOBILE_TEST_MERCHANT_ID=27432553
TAP_MERCHANT_ID=27432553
NEXT_PUBLIC_TAP_MERCHANT_ID=27432553
TAP_MARKETPLACE_MID=27432553
# Encrypts Tap credentials saved from the admin dashboard. Optional: when unset
# the dashboard cannot store secret keys and the TAP_* variables above remain
# the source of truth. Use a long random value (>= 16 characters).
TAP_CONFIG_ENCRYPTION_KEY=
# Public origin Tap redirects + webhooks back to. Use ngrok for local dev.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Verified Saraya mobile links. Leave unset to publish empty fail-safe associations.
SARAYA_ANDROID_SHA256_CERT_FINGERPRINTS=
SARAYA_APPLE_TEAM_ID=
