# Copy this file to .env.local and fill in the values.
# .env.local is gitignored.
# ──────────────────────────────────────────────────────────────────────
# Database (local Postgres via docker-compose)
# ──────────────────────────────────────────────────────────────────────
  
DATABASE_URL=

# WhatsApp Dr. Nabih assistant. Keep every value server-only.
# Do not copy live tokens into source control.
META_WHATSAPP_VERIFY_TOKEN=
META_WHATSAPP_APP_SECRET=
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_GRAPH_VERSION=
OPENAI_API_KEY=
OPENAI_WHATSAPP_MODEL=

# ──────────────────────────────────────────────────────────────────────
# Legal SOS dispatch
# ──────────────────────────────────────────────────────────────────────
# Phone number that receives the WhatsApp dispatch link and a fallback SMS.
# Defaults to the existing dispatch number if unset.

SOS_DISPATCH_PHONE=
SOS_DISPATCH_EMAIL=

# Internal dispatch dashboard — HTTP basic auth at /sos/dispatch

DISPATCH_USERNAME=
DISPATCH_PASSWORD=

# Lawyer-side magic-link + session signing secret. Generate with
# `openssl rand -base64 32` for production.

LAWYER_AUTH_SECRET=

# Web Push VAPID keypair for lawyer push notifications.
# Generate with: `node -e "console.log(require('web-push').generateVAPIDKeys())"`
# The public key is exposed to the browser via NEXT_PUBLIC_*.

NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Shared secret for Vercel Cron jobs (auto-settle nightly run, etc.)
# Generate with `openssl rand -base64 32`. Vercel sends it as
# `Authorization: Bearer ${CRON_SECRET}` automatically when set.

CRON_SECRET=

# ──────────────────────────────────────────────────────────────────────
# Postmark (already wired for /api/contact and /api/join)
# ──────────────────────────────────────────────────────────────────────

POSTMARK_TOKEN=
POSTMARK_FROM=

# ──────────────────────────────────────────────────────────────────────
# Tap Payments (used for the booking flow + future SOS Initial Response Fee)
# ──────────────────────────────────────────────────────────────────────

NEXT_PUBLIC_TAP_SECRET_KEY=
NEXT_PUBLIC_TAP_PUBLIC_KEY=

